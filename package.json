{
  "name": "input-translate-ext",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs --zip",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{js,json,md,css}\"",
    "format:fix": "prettier --write \"**/*.{js,json,md,css}\""
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
