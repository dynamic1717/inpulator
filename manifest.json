{
  "manifest_version": 3,
  "name": "Input Translate",
  "version": "0.3.6",
  "description": "Translate selected Russian text to English in input fields",
  "permissions": ["clipboardRead", "clipboardWrite"],
  "host_permissions": ["https://api.mymemory.translated.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Translate selected text to English"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shadow-dom.js",
        "field-clipboard.js",
        "field-native.js",
        "field-editable.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
