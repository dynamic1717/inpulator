{
  "manifest_version": 3,
  "name": "Inpulator",
  "version": "1.0.0",
  "description": "Перевод выделенного текста в полях ввода с русского языка на английский.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Inpulator — Перевод текста",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["clipboardRead", "clipboardWrite", "storage", "offscreen"],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://translation.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Option+Shift+T"
      },
      "description": "Перевести выделенный текст с русского на английский"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "settings.js",
        "shadow-dom.js",
        "field-clipboard.js",
        "field-native.js",
        "field-editable.js",
        "floating-ui.js",
        "selection-context.js",
        "selection-observer.js",
        "runtime-client.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
