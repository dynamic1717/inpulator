{
  "manifest_version": 3,
  "name": "Input Translate",
  "version": "0.7.0",
  "description": "Translate selected Russian text to English in input fields",
  "permissions": ["clipboardRead", "clipboardWrite", "storage"],
  "host_permissions": ["https://api.mymemory.translated.net/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Translate selected text to English"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shadow-dom.js",
        "field-clipboard.js",
        "field-native.js",
        "field-editable.js",
        "floating-ui.js",
        "selection-context.js",
        "selection-observer.js",
        "runtime-client.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
